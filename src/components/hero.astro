---
// ALLSMARTINC ALL RIGHTS RESERVED 2025
import { Picture } from "astro:assets";

//import Typed from "typed.js";
//import { onMount } from "solid-js";

import Link from "@components/ui/link.astro";

import EtradePhoneIMG from "@assets/LOLO.png";

import { siGoogleplay, siOwncloud } from "simple-icons";
---
<main
  class="grid lg:grid-cols-2 place-items-center pt-16 pb-8 md:pt-12 md:pb-24">
  <div class="py-6 md:order-1 hidden md:block">
    <Picture
      src={EtradePhoneIMG}
      alt="Astronaut in the air"
      widths={[200, 400, 600]}
      sizes="(max-width: 800px) 100vw, 620px"
      loading="eager"
      format="avif"
    />
  </div>
  <div>
    <h1
      class="text-5xl lg:text-6xl xl:text-7xl font-bold lg:tracking-tight xl:tracking-tighter">
      Rebalance – Smart Portfolio Management Made Simple
    </h1>
    <p class="text-lg mt-4 text-slate-600 max-w-xl">
      Take control of your investments! Connect with E*TRADE, track, and
      rebalance effortlessly.
    </p>
    <div class="mt-6 flex flex-col sm:flex-row gap-3">
      <Link
        size="lg"
        style="outline"
        rel="noopener"
        href="https://allsmartinc.com/"
        class="flex gap-1 items-center justify-center"
        target="_blank">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
          <path d={siGoogleplay.path}></path>
        </svg>
        GOOGLE PLAY
      </Link>
    </div>
  </div>

</main>
