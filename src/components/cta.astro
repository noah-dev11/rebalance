---
import Link from "./ui/link.astro";
import { siGoogleplay, siAppstore } from "simple-icons";
---

<div
  class="bg-white p-8 md:px-20 md:py-20 mt-20 mx-auto max-w-5xl rounded-lg flex flex-col items-center text-center">
  <h2 class="text-dark text-4xl md:text-6xl tracking-tight">
    Your Portfolio - Your Rules
  </h2>
  <p class="text-dark-400 mt-4 text-lg md:text-xl">
    Our app simplifies investment management, automatically optimizing your portfolio to maximize returns and minimize risks.
  </p>
  <div class="flex mt-5">
    <Link
    size="lg"
    style="outline"
    rel="noopener"
    href="#"
    class="flex gap-1 items-center justify-center"
    target="_blank">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
      <path d={siGoogleplay.path} />
    </svg>  
    Download Rebalance
  </Link>
  </div>
</div>
